# AWS S3 Configuration for AI Models
# Copy this file to .env and fill in your actual AWS credentials

# AWS Credentials (Required for S3 uploads)
NEXT_PUBLIC_AWS_ACCESS_KEY_ID=your_aws_access_key_here
NEXT_PUBLIC_AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
NEXT_PUBLIC_AWS_REGION=us-east-1
NEXT_PUBLIC_S3_BUCKET=signatureai-uploads

# Optional: Custom S3 public base URL (if using CloudFront or custom domain)
# NEXT_PUBLIC_S3_PUBLIC_BASE_URL=https://your-custom-domain.com

# AI Service Configuration (Backend Server)
VITE_AI_BASE_URL=http://localhost:8000

# Enable S3 Storage (set to 'true' to enable S3 exports, 'false' for local downloads only)
VITE_ENABLE_S3_STORAGE=true